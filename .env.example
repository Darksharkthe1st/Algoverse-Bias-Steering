# Copy to `.env` and fill in. `.env` is gitignored (.gitignore:141) — never commit real keys.
#
# Loaded automatically by `python -m src.bias_steer ...` (see cli.py:_load_env).
# Values already exported in your shell always win over this file.

# ---------------------------------------------------------------------------
# REQUIRED — read directly by our code
# ---------------------------------------------------------------------------

# The LLM-as-a-judge backend. Read in judge.py:_judge_async via os.getenv.
# Needed by BOTH pipeline phases: train (verdicts bucket the residuals that
# build the steering vector) and eval (verdicts score all three arms). Without
# it no run completes.
#   Cost per run ~= (n_train + 3 * n_test) gpt-4o-mini calls.
OPENAI_API_KEY=sk-...


# ---------------------------------------------------------------------------
# CONDITIONALLY REQUIRED — read by libraries, not by our code
# ---------------------------------------------------------------------------

# HuggingFace token, consumed by huggingface_hub during model download.
# Only needed for GATED models. Of the MODEL_CATALOG (models.py):
#   ungated, work with no token : qwen-1.8b, qwen-7b, qwen-14b, yi-6b
#   GATED, need an approved token: gemma-2b, gemma-7b, llama3-8b
# Approval is per-account on the model page and is not instant — request access
# before you need those runs. `huggingface-cli login` is an equivalent
# alternative to setting this.
HF_TOKEN=hf_...


# ---------------------------------------------------------------------------
# OPTIONAL — useful on this box, safe to leave unset
# ---------------------------------------------------------------------------

# Where HuggingFace caches downloaded weights. Defaults to ~/.cache/huggingface.
# Worth pointing somewhere roomy: the catalog totals well over 100GB in fp16
# (qwen-14b alone is ~28GB) and the models are re-downloaded per machine.
# HF_HOME=/lambda/nfs/farhan-algoverse-summer26/.hf_cache

# Pin the judge to a dated snapshot instead of the floating `gpt-4o-mini` alias.
# NOT read by any code — JudgeSpec.model is a config field (config.py), not an
# env var. Listed only because docs/needed-experiments.md §0.2 calls the unpinned
# alias a correctness problem for any result you intend to defend; fix it in the
# config, not here.
